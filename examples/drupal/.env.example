SITE_IMAGE=freeunit-drupal-example:local
SITE_HTTP_PORT=8080
SITE_HOSTNAME=localhost
SITE_TRUSTED_HOST_PATTERNS='^localhost$'
SITE_REDIS_MAXMEMORY=256mb
SITE_REDIS_ENABLE=0
FREEUNIT_DRUPAL_TMP_DIR=./data/tmp
SITE_DB_PASSWORD_FILE=./secrets/db_password
SITE_DB_ROOT_PASSWORD_FILE=./secrets/db_root_password
SITE_REDIS_PASSWORD_FILE=./secrets/redis_password
SITE_HASH_SALT_FILE=./secrets/hash_salt
